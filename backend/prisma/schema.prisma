generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Definicje stałych (Słowniki)
enum Role {
  ADMIN
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// 2. Modele Danych (Tabele)

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String          // Nigdy nie trzymaj haseł jawnym tekstem!
  name          String
  createdAt     DateTime        @default(now())
  
  // Relacje - powiązania z innymi tabelami
  projectRoles  ProjectMember[] // W jakich projektach uczestniczy i z jaką rolą
  assignedTasks Task[]          @relation("TaskAssignee") // Jakie ma zadania
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())

  // Relacje
  members     ProjectMember[] // Kto ma dostęp do projektu
  tasks       Task[]          // Zadania w tym projekcie
}

// Tabela Łącząca (Klucz do systemu RBAC)
model ProjectMember {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role     @default(DEVELOPER)
  joinedAt  DateTime @default(now())

  // Definicja kluczy obcych
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Zabezpieczenie: dany użytkownik może być przypisany do projektu tylko raz
  @@unique([userId, projectId]) 
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt // Prisma sama to zaktualizuje

  // Powiązanie zadania z projektem (Wymagane)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Powiązanie zadania z użytkownikiem (Opcjonalne - zadanie może nie być przypisane)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}