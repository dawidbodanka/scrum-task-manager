// ============================================================================
// DATABASE SCHEMA DEFINITION
// ============================================================================
// This file defines the PostgreSQL database architecture using Prisma ORM.
// It implements a multi-tenant SaaS structure with Role-Based Access Control (RBAC).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 1. ENUMS (Static Types)
// ============================================================================

// Defines the strict permission levels within a specific project
enum Role {
  ADMIN       // Full access: manage members, create/edit/delete tasks, manage project
  DEVELOPER   // Restricted access: can only update task status and self-assign tasks
}

// Represents board columns
enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

// Task urgency levels for sorting
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ============================================================================
// 2. DATA MODELS (Tables)
// ============================================================================

// Core authentication entity. Represents a registered application user.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   
  name         String
  createdAt    DateTime @default(now())
  
  // Relations
  projectRoles  ProjectMember[] // Workspaces the user has access to
  assignedTasks Task[]          @relation("TaskAssignee") // Tasks currently assigned to this user
}

// The main workspace entity. Each project acts as an isolated board.
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  // Relations
  members     ProjectMember[] // Users who have been invited to this project
  tasks       Task[]          // All tasks belonging to this specific project
}

// Junction Table (Many-to-Many): Connects Users to Projects with a specific Role.
model ProjectMember {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role     @default(DEVELOPER)
  joinedAt  DateTime @default(now())

  // Foreign keys with Cascade deletion
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // A user can only be added to a specific project once
  @@unique([userId, projectId]) 
}

// The core work item on the board.
model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt 

  // Which project does this task belong to?
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Who is working on this task? (Optional)
  // SetNull: If the assigned user is deleted from the system, the task remains but becomes unassigned.
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}