generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Enums
enum Role {
  ADMIN
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// 2. Tables

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String          
  name          String
  createdAt     DateTime        @default(now())
  
  // Relations
  projectRoles  ProjectMember[] // In which projects and as which role
  assignedTasks Task[]          @relation("TaskAssignee") // What are their tasks?
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())

  // Relations
  members     ProjectMember[] // Who can access the project
  tasks       Task[]          // Tasks in this project
}

// Connection table
model ProjectMember {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role     @default(DEVELOPER)
  joinedAt  DateTime @default(now())

  // Foreign keys
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // User can be assigned to certain project only once
  @@unique([userId, projectId]) 
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt 

  // Task - project connection
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Task - user connection
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}